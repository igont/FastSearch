  ],
  "inputs": [
    {
      "id": "IN-CONFIRMED-WORKSPACE-ROOTS",
      "meaning": "Подтверждённый корень области и выбранные корни documentation и code",
      "required": true,
      "producer": "FastSearch user admission flow",
      "authority": {"kind": "SOURCE_OF_TRUTH", "source_ref": "../../../src/application/workspace.rs#WorkspaceProfile::from_roots", "sha256": "1fde90cd765bcead8853ea4e37f35c5f84b06c3febd3b1a05c55ab86f990558b"},
      "format": "Existing directories and display name",
      "schema_ref": "../../../src/application/workspace.rs#WorkspaceProfile::from_roots",
      "version": "1",
      "identity": "Канонический корень рабочей области",
      "units": "filesystem paths",
      "precision": "EXACT",
      "order": "ORDERED",
      "cardinality": "1 workspace, 0..N roots per contour"
    }
  ],
  "outputs": [
    {
      "id": "OUT-WORKSPACE-PROFILE",
      "meaning": "Проверенный переносимый профиль рабочей области",
      "producer": "application::workspace",
      "format": "WorkspaceProfile v1 persisted as .fastsearch/workspace.toml",
      "schema_ref": "../../../src/application/workspace.rs#WorkspaceProfile",
      "version": "1",
      "identity": "workspace id and rooted source ids",
      "units": "relative paths",
      "precision": "EXACT",
      "order": "ORDERED",
      "cardinality": "1 profile",
