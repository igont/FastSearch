{
  "$schema": "https://codex.local/schemas/boundary-contract-v1.schema.json",
  "schema": "boundary-contract/v1",
  "contract_id": "BC-FS-WORKSPACE-ADMISSION",
  "contract_version": "1",
  "status": "DRAFT",
  "human_contract": "BC-FS-WORKSPACE-ADMISSION.md",
  "producer": {"module": "application::workspace", "responsibility": "Создать, атомарно сохранить и повторно проверить переносимый профиль рабочей области"},
  "execution_scope": {
    "platform_strategy": "CURRENT_ONLY",
    "current_environments": ["Windows local filesystem"],
    "deferred_environments": [
      {"environment": "Linux local filesystem", "architecture_status": "EXTENSION_POINT_DEFINED", "implementation_status": "NOT_IMPLEMENTED"},
      {"environment": "macOS local filesystem", "architecture_status": "EXTENSION_POINT_DEFINED", "implementation_status": "NOT_IMPLEMENTED"}
    ],
    "ports": [
      {"id": "PORT-WORKSPACE-FILESYSTEM", "owner": "application::workspace", "capabilities": ["канонизировать каталоги", "атомарно записать UTF-8 TOML", "повторно прочитать профиль"], "required_now": true, "implementation_status": "IMPLEMENTED"}
    ]
  },
  "consumers": ["WorkspaceStore::production_config"],
  "machine_contracts": [
    {"kind": "source-interface", "path": "../../../src/application/workspace.rs", "symbol": "WorkspaceProfile, WorkspaceStore"},
