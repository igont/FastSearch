  ],
  "transformations": [
    {"id": "TR-ADMIT-WORKSPACE", "owner": "application::workspace", "kind": "NORMALIZE", "input_ids": ["IN-CONFIRMED-WORKSPACE-ROOTS"], "output_ids": ["OUT-WORKSPACE-PROFILE"], "rule": "Канонизировать корень, сохранить источники относительными путями и вычислить устойчивые идентификаторы по контуру", "loss": "NONE"}
  ],
  "handoffs": [
    {
      "id": "HO-WORKSPACE-TO-PRODUCTION",
      "from": "application::workspace",
      "to": "WorkspaceStore::production_config",
