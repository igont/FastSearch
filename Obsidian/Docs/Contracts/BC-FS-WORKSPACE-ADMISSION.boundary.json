      "preconditions": ["Профиль повторно прошёл validate_profile"],
      "consumer_obligations": ["Разрешать только допущенные корни", "Не считать ноль контуров готовностью поиска"],
      "success": "Производственная конфигурация получает те же корни и идентичность",
      "failures": ["Неизвестная версия", "повреждённый TOML", "недоступный или внешний корень"],
      "acceptance_refs": ["tests/workspace_runtime.rs"],
      "unblocks": ["Открытие производственной поисковой среды"]
    }
  ],
  "flow_edges": [
    {"from": "FastSearch user admission flow", "to": "application::workspace", "data_ids": ["IN-CONFIRMED-WORKSPACE-ROOTS"]},
    {"from": "application::workspace", "to": ".fastsearch/workspace.toml", "data_ids": ["OUT-WORKSPACE-PROFILE"], "transformation_id": "TR-ADMIT-WORKSPACE"},
    {"from": ".fastsearch/workspace.toml", "to": "WorkspaceStore::open", "data_ids": ["OUT-WORKSPACE-PROFILE"]},
    {"from": "WorkspaceStore::open", "to": "WorkspaceStore::production_config", "data_ids": ["OUT-WORKSPACE-PROFILE"]}
  ],
  "evidence": {
    "integration_decision": {"status": "REQUIRED", "reason": "Профиль пересекает устойчивую файловую границу и повторно читается потребителем", "authority_ref": {"path": "BC-FS-WORKSPACE-ADMISSION.md", "sha256": "6071aeb179430256cb87d21ddccb7757df7af0c6d9266a3621e460010b598039"}},
    "contract_tests": [{"path": "../../../tests/workspace_runtime.rs", "status": "PLANNED"}],
    "integration_tests": [{"path": "../../../tests/workspace_runtime.rs", "status": "PLANNED"}]
  },
  "blockers": []
